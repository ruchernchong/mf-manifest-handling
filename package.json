{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "biome check --write",
    "dev": "pnpm --filter @mf-manifest-handling/web run dev",
    "format": "biome format --write",
    "preview": "pnpm --filter @mf-manifest-handling/web run preview",
    "test": "pnpm -r run test",
    "test:watch": "pnpm --filter @mf-manifest-handling/web run test:watch",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
